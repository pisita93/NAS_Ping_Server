# Web server
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string

# Initial admin (used only on first boot to create the admin row)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Where SQLite + sessions live (must be writable by the container user)
DATA_DIR=/data

# Gmail SMTP for failure notifications
# Use a Google App Password (not your real password):
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your.address@gmail.com
SMTP_PASS=your-16-char-app-password
NOTIFY_FROM="NAS Ping Server <your.address@gmail.com>"
NOTIFY_TO=your.address@gmail.com

# Send an email after this many consecutive failures (avoid spam)
NOTIFY_FAILURE_THRESHOLD=2

# How many execution rows to keep per job
EXECUTION_RETENTION=1000

# Optional public URL used in email links (e.g. http://nas.local:3000)
PUBLIC_URL=
